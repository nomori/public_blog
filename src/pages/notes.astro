---
import Base from '../layouts/Base.astro';
import NoteCard from '../components/NoteCard.astro';
import { getNotes } from '../lib/content';
const notes = await getNotes();
const sources = [...new Set(notes.map((n) => n.data.source))];
const LABEL = { local: 'Notes', x: 'X', bluesky: 'Bluesky', mastodon: 'Mastodon' } as const;
---
<Base title="Notes" description="日々の短いつぶやき（X からの取り込みを含む）" section="Notes">
  <div class="measure">
    <header class="page-head">
      <p class="eyebrow">Notes</p>
      <h1>つぶやき</h1>
      <p class="lede num">{notes.length} notes</p>
    </header>
    {sources.length > 1 && (
      <div class="filters" role="group" aria-label="取り込み元で絞り込み">
        <button type="button" class="chip" data-src="all" aria-pressed="true" id="src-all">All</button>
        {sources.map((s) => <button type="button" class="chip" data-src={s} aria-pressed="false" id={`src-${s}`}>{LABEL[s]}</button>)}
      </div>
    )}
    <div class="list" data-pagefind-body>
      {notes.map((n) => <NoteCard note={n} />)}
    </div>
  </div>
</Base>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-src]');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.note').forEach((n) => (n.hidden = b.dataset.src !== 'all' && n.dataset.source !== b.dataset.src));
  }));
</script>
<style>
  .filters { display: flex; gap: .5rem; margin: 1.5rem 0 .5rem; }
  .list :global(.note:target) { background: var(--accent-soft); margin-inline: -1rem; padding-inline: 1rem; border-radius: 6px; }
</style>
