---
// アクティビティの統計 ＋ 標高プロファイル ＋ Leaflet地図の双方向連動
// 写真の位置ピン（カメラアイコン）も地図と標高プロファイル上にマッピング
import fs from 'node:fs';
import path from 'node:path';
import type { PostPhoto } from '../lib/photos';

interface Props {
  activity: NonNullable<import('../lib/content').Post['data']['activity']>;
  photos?: PostPhoto[];
}
const { activity, photos = [] } = Astro.props;

// points: [lat, lon, ele, distKm, epochSec|null]
type Pt = [number, number, number | null, number, (number | null)?];
let points: Pt[] = [];
if (activity.route) {
  const file = path.join(process.cwd(), 'public', activity.route);
  if (fs.existsSync(file)) {
    points = JSON.parse(fs.readFileSync(file, 'utf8')).points ?? [];
  }
}

const W = 800, H = 160, P = 12;
let areaPath = '', linePath = '', minE = 0, maxE = 0;
const elev = points.filter((p) => p[2] != null);
let totalDist = 0;

if (elev.length > 1) {
  totalDist = elev[elev.length - 1][3] || 1;
  minE = Math.min(...elev.map((p) => p[2]!));
  maxE = Math.max(...elev.map((p) => p[2]!));
  const range = maxE - minE || 1;
  const xy = elev.map((p) => [
    P + (p[3] / totalDist) * (W - 2 * P),
    H - P - ((p[2]! - minE) / range) * (H - 2 * P - 10)
  ]);
  linePath = 'M' + xy.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L');
  areaPath = `${linePath}L${xy[xy.length - 1][0].toFixed(1)},${H}L${xy[0][0].toFixed(1)},${H}Z`;
}

// 写真の位置（距離km、lat/lon）を持つもの
const photoPins = photos
  .filter((p) => p.lat != null && p.lon != null)
  .map((p, idx) => ({
    id: `photo-${idx}`,
    file: p.file,
    caption: p.caption || p.file,
    src: p.img.src,
    lat: p.lat!,
    lon: p.lon!,
    distKm: p.distKm ?? 0,
    xPercent: totalDist > 0 && p.distKm != null ? Math.min(100, Math.max(0, (p.distKm / totalDist) * 100)) : null,
  }));

const stats = [
  { label: 'Distance', value: activity.distanceKm, unit: 'km' },
  { label: 'Elevation ↑', value: activity.elevationGainM, unit: 'm' },
  { label: 'Elevation ↓', value: activity.elevationLossM, unit: 'm' },
  { label: 'Max Elev.', value: activity.maxElevationM, unit: 'm' },
  { label: 'Moving', value: activity.movingTime, unit: '' },
  { label: 'Elapsed', value: activity.elapsedTime, unit: '' },
  { label: 'Pace', value: activity.pace, unit: '' },
].filter((s) => s.value != null && s.value !== '');
---

<section class="activity-section" aria-label="アクティビティ記録">
  {activity.location && <p class="eyebrow loc">📍 {activity.location}</p>}
  <dl class="stats-grid">
    {stats.map((s) => (
      <div>
        <dt class="eyebrow">{s.label}</dt>
        <dd class="num">{s.value}<small>{s.unit}</small></dd>
      </div>
    ))}
  </dl>

  {points.length > 1 && (
    <div class="map-container">
      <div
        id="route-map"
        class="map"
        data-route={JSON.stringify(points)}
        data-photos={JSON.stringify(photoPins)}
      ></div>
      <div id="map-hover-badge" class="map-badge num" style="display: none;"></div>
    </div>
  )}

  {linePath && (
    <div class="profile-container">
      <div class="profile-header">
        <span class="eyebrow">Elevation & Route Sync</span>
        <span id="profile-indicator" class="num indicator">グラフをなぞると地図と連動します</span>
      </div>

      <div class="svg-wrap" id="elevation-wrap">
        <svg
          id="elevation-svg"
          viewBox={`0 0 ${W} ${H}`}
          preserveAspectRatio="none"
          role="img"
          aria-label="標高プロファイル"
        >
          <defs>
            <linearGradient id="elev-g" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="var(--accent)" stop-opacity=".4" />
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.02" />
            </linearGradient>
          </defs>
          <path d={areaPath} fill="url(#elev-g)" />
          <path d={linePath} fill="none" stroke="var(--accent)" stroke-width="2" vector-effect="non-scaling-stroke" />
          
          <!-- ホバー縦線 -->
          <line id="hover-line" x1="-10" y1="0" x2="-10" y2={H} stroke="var(--ink)" stroke-dasharray="3 3" stroke-width="1.5" style="display: none;" />
          <circle id="hover-point" cx="-10" cy="-10" r="4.5" fill="var(--accent)" stroke="#fff" stroke-width="2" style="display: none;" />
        </svg>

        <!-- 写真マーカー（標高プロファイル上の位置） -->
        {photoPins.filter((p) => p.xPercent !== null).map((p) => (
          <a
            href={`#img-${p.file}`}
            class="profile-photo-marker"
            style={`left: ${p.xPercent}%`}
            title={`📷 ${p.caption}`}
          >
            <span class="dot"></span>
          </a>
        ))}
      </div>

      <div class="profile-footer num">
        <span>{Math.round(minE)} m</span>
        <span>0 km</span>
        <span>{totalDist.toFixed(1)} km</span>
        <span>{Math.round(maxE)} m</span>
      </div>
    </div>
  )}
</section>

{points.length > 1 && (
  <>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script is:inline>
      (() => {
        const mapEl = document.getElementById('route-map');
        const elevSvg = document.getElementById('elevation-svg');
        const elevWrap = document.getElementById('elevation-wrap');
        const hoverLine = document.getElementById('hover-line');
        const hoverPoint = document.getElementById('hover-point');
        const indicator = document.getElementById('profile-indicator');
        const mapBadge = document.getElementById('map-hover-badge');

        if (!mapEl || !window.L) return;

        // pts: [lat, lon, ele, distKm, epochSec]
        const pts = JSON.parse(mapEl.dataset.route || '[]');
        const photos = JSON.parse(mapEl.dataset.photos || '[]');
        if (pts.length < 2) return;

        // Leaflet初期化
        const map = L.map(mapEl, {
          scrollWheelZoom: false,
          attributionControl: true
        });

        L.tileLayer('https://cyberjapandata.gsi.go.jp/xyz/pale/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '<a href="https://maps.gsi.go.jp/development/ichiran.html">国土地理院</a>',
        }).addTo(map);

        const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#3a7d5c';
        const latlngs = pts.map((p) => [p[0], p[1]]);

        // メインルート
        const polyline = L.polyline(latlngs, {
          color: accentColor,
          weight: 4,
          opacity: 0.9,
          lineJoin: 'round'
        }).addTo(map);

        // スタート & ゴールマーカー
        L.circleMarker(latlngs[0], { radius: 6, color: accentColor, fillColor: '#ffffff', fillOpacity: 1, weight: 3 }).addTo(map).bindTooltip('Start');
        L.circleMarker(latlngs[latlngs.length - 1], { radius: 6, color: '#e05353', fillColor: '#ffffff', fillOpacity: 1, weight: 3 }).addTo(map).bindTooltip('Goal');

        // 写真ピンの配置
        photos.forEach((ph) => {
          const photoIcon = L.divIcon({
            className: 'custom-photo-pin',
            html: `<div class="photo-pin-inner"><span class="camera-icon">📷</span></div>`,
            iconSize: [28, 28],
            iconAnchor: [14, 28],
            popupAnchor: [0, -28]
          });

          const popupContent = `
            <div style="width: 160px; font-family: var(--sans);">
              <img src="${ph.src}" alt="${ph.caption}" style="width: 100%; height: 100px; object-fit: cover; border-radius: 4px; display: block; margin-bottom: 6px;" />
              <div style="font-size: 11px; font-weight: 500; line-height: 1.3;">${ph.caption}</div>
              <div style="font-size: 10px; color: #888; margin-top: 3px;">📍 ${ph.distKm.toFixed(1)} km地点</div>
            </div>
          `;
          L.marker([ph.lat, ph.lon], { icon: photoIcon })
            .addTo(map)
            .bindPopup(popupContent);
        });

        map.fitBounds(polyline.getBounds(), { padding: [35, 35] });

        // --- 双方向連動マーカー ---
        const cursorMarker = L.circleMarker([pts[0][0], pts[0][1]], {
          radius: 7,
          color: '#ffffff',
          fillColor: accentColor,
          fillOpacity: 1,
          weight: 2
        });

        // 標高グラフ座標計算用
        const totalDist = pts[pts.length - 1][3] || 1;
        const validEles = pts.map(p => p[2]).filter(e => e != null);
        const minE = validEles.length ? Math.min(...validEles) : 0;
        const maxE = validEles.length ? Math.max(...validEles) : 1;
        const rangeE = maxE - minE || 1;
        const W = 800, H = 160, P = 12;

        function getSvgY(ele) {
          if (ele == null) return H / 2;
          return H - P - ((ele - minE) / rangeE) * (H - 2 * P - 10);
        }

        function updateAtDistance(distKm) {
          // distKm に最も近いトラックポイントを探索（二分探索または走査）
          let idx = 0;
          let minDiff = Infinity;
          for (let i = 0; i < pts.length; i++) {
            const diff = Math.abs(pts[i][3] - distKm);
            if (diff < minDiff) {
              minDiff = diff;
              idx = i;
            }
          }
          const pt = pts[idx];
          const lat = pt[0], lon = pt[1], ele = pt[2];

          // 地図上のマーカー更新
          if (!map.hasLayer(cursorMarker)) cursorMarker.addTo(map);
          cursorMarker.setLatLng([lat, lon]);

          // 地図バッジ
          if (mapBadge) {
            mapBadge.style.display = 'block';
            mapBadge.innerHTML = `${pt[3].toFixed(1)} km · ${ele != null ? Math.round(ele) + ' m' : ''}`;
          }

          // 標高SVG上のカーソル更新
          if (hoverLine && hoverPoint) {
            const x = P + (pt[3] / totalDist) * (W - 2 * P);
            const y = getSvgY(ele);
            hoverLine.setAttribute('x1', x);
            hoverLine.setAttribute('x2', x);
            hoverLine.style.display = 'block';
            hoverPoint.setAttribute('cx', x);
            hoverPoint.setAttribute('cy', y);
            hoverPoint.style.display = 'block';
          }

          if (indicator) {
            indicator.textContent = `${pt[3].toFixed(2)} km地点 / 標高 ${ele != null ? Math.round(ele) + ' m' : '—'}`;
          }
        }

        function clearHover() {
          if (map.hasLayer(cursorMarker)) map.removeLayer(cursorMarker);
          if (hoverLine) hoverLine.style.display = 'none';
          if (hoverPoint) hoverPoint.style.display = 'none';
          if (mapBadge) mapBadge.style.display = 'none';
          if (indicator) indicator.textContent = 'グラフをなぞると地図と連動します';
        }

        // 標高SVGマウス/タッチイベント
        if (elevWrap) {
          const onMove = (e) => {
            const rect = elevWrap.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const relX = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
            const targetDist = relX * totalDist;
            updateAtDistance(targetDist);
          };

          elevWrap.addEventListener('mousemove', onMove);
          elevWrap.addEventListener('touchmove', onMove, { passive: true });
          elevWrap.addEventListener('mouseleave', clearHover);
          elevWrap.addEventListener('touchend', clearHover);
        }

        // 地図上のポリラインをホバーした時
        polyline.on('mousemove', (e) => {
          // 最も近いポイントを特定
          let minD = Infinity;
          let bestDist = 0;
          for (let i = 0; i < pts.length; i++) {
            const d = Math.hypot(pts[i][0] - e.latlng.lat, pts[i][1] - e.latlng.lng);
            if (d < minD) {
              minD = d;
              bestDist = pts[i][3];
            }
          }
          updateAtDistance(bestDist);
        });
        polyline.on('mouseout', clearHover);
      })();
    </script>
  </>
)}

<style>
  .activity-section { margin: 3rem 0; padding: 2rem 0; border-block: 1px solid var(--line); }
  .loc { margin: 0 0 1.2rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr)); gap: 1.5rem 1rem; margin: 0 0 2rem; }
  dt { margin-bottom: .2rem; }
  dd { margin: 0; font-size: 1.6rem; font-weight: 300; letter-spacing: 0; line-height: 1.2; }
  dd small { font-size: .8rem; margin-left: .2rem; color: var(--ink-soft); }

  .map-container { position: relative; margin-top: 1.5rem; }
  .map { height: 380px; border-radius: 6px; overflow: hidden; background: var(--bg-soft); z-index: 1; }
  .map-badge {
    position: absolute; top: 12px; right: 12px; z-index: 1000;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    padding: 4px 10px; border-radius: 99px; font-size: 0.75rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08); pointer-events: none;
  }
  :global([data-theme='dark']) .map :global(.leaflet-tile) {
    filter: invert(.9) hue-rotate(180deg) saturate(.4) brightness(.9);
  }

  /* 写真ピン */
  :global(.custom-photo-pin) { display: flex; align-items: center; justify-content: center; }
  :global(.photo-pin-inner) {
    background: #ffffff;
    border: 2px solid var(--accent);
    border-radius: 50%;
    width: 26px; height: 26px;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.25);
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.photo-pin-inner:hover) { transform: scale(1.2); }

  /* 標高プロファイル */
  .profile-container { margin-top: 1.5rem; }
  .profile-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .5rem; }
  .indicator { font-size: .75rem; color: var(--accent); }
  
  .svg-wrap {
    position: relative; width: 100%; height: 130px;
    background: color-mix(in srgb, var(--bg-soft) 40%, transparent);
    border-radius: 4px; border: 1px solid var(--line);
    cursor: crosshair; touch-action: none;
  }
  .svg-wrap svg { width: 100%; height: 100%; display: block; overflow: visible; }

  /* プロファイル上の写真マーカー */
  .profile-photo-marker {
    position: absolute; top: 8px; transform: translateX(-50%);
    width: 14px; height: 14px;
    display: flex; align-items: center; justify-content: center;
    z-index: 5;
  }
  .profile-photo-marker .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--ink); border: 1px solid var(--bg);
    transition: transform .2s;
  }
  .profile-photo-marker:hover .dot { transform: scale(2); background: var(--accent); }

  .profile-footer {
    display: flex; justify-content: space-between;
    font-size: .72rem; color: var(--ink-faint); margin-top: .4rem;
  }
</style>
