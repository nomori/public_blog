---
import { SITE_TITLE, THEMES } from '../consts';
import { url } from '../lib/content';
const path = Astro.url.pathname;
const { section } = Astro.props as { section?: string };
const nav = [
  { href: url('/logs/'), label: 'Logs' },
  { href: url('/articles/'), label: 'Articles' },
  { href: url('/notes/'), label: 'Notes' },
  { href: url('/books/'), label: 'Books' },
  { href: url('/stats/'), label: 'Stats' },
];
---
<header class="site-header">
  <div class="container inner">
    <a href={url('/')} class="brand" id="brand-link">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 20 L9 8 L13 14 L16 10 L22 20 Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      <span>{SITE_TITLE}</span>
    </a>
    <nav aria-label="メイン">
      {nav.map((n) => (
        <a href={n.href} class:list={['nav-link', { active: section ? section === n.label : path.startsWith(n.href) }]} id={`nav-${n.label.toLowerCase()}`}>{n.label}</a>
      ))}
      <a href={url('/search/')} class="icon-btn" aria-label="検索" id="nav-search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>

      <!-- カラーパレット選択 -->
      <div class="palette-wrap">
        <button class="icon-btn" id="palette-btn" aria-label="カラーテーマを選択" title="テーマカラー切替">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.93 0 1.5-.68 1.5-1.5 0-.38-.15-.74-.42-1.01-.28-.27-.43-.63-.43-1.01 0-.83.67-1.5 1.5-1.5H16c3.31 0 6-2.69 6-6 0-4.97-4.48-9-10-9z"/></svg>
        </button>
        <div class="palette-popover" id="palette-popover" hidden>
          <div class="palette-title eyebrow">Theme Color</div>
          <div class="palette-list">
            {Object.entries(THEMES).map(([k, t]) => (
              <button type="button" class="palette-item" data-preset={k} title={t.desc}>
                <span class={`swatch swatch-${k}`}></span>
                <span class="p-name">{t.name}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- ダークモード切替 -->
      <button class="icon-btn" id="theme-toggle" aria-label="テーマ切替">
        <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // ダークモード
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });

  // カラーテーマ切替
  const pop = document.getElementById('palette-popover');
  const pBtn = document.getElementById('palette-btn');
  pBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (pop) pop.hidden = !pop.hidden;
  });
  document.addEventListener('click', (e) => {
    if (pop && !pop.contains(e.target as Node) && e.target !== pBtn) {
      pop.hidden = true;
    }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const preset = btn.dataset.preset!;
      document.documentElement.dataset.themePreset = preset;
      localStorage.setItem('theme-preset', preset);
      if (pop) pop.hidden = true;
    });
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px) saturate(1.4);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }
  .inner { display: flex; align-items: center; justify-content: space-between; height: 4rem; }
  .brand { display: flex; align-items: center; gap: .6rem; font-family: var(--serif); font-weight: 700; font-size: 1.05rem; letter-spacing: .06em; }
  .brand svg { color: var(--accent); transition: transform .5s var(--ease); }
  .brand:hover svg { transform: translateY(-2px); }
  nav { display: flex; align-items: center; gap: 1.6rem; }
  .nav-link { font-size: .8rem; letter-spacing: .12em; color: var(--ink-soft); position: relative; transition: color .25s; }
  .nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px; background: var(--accent); transform: scaleX(0); transition: transform .35s var(--ease); }
  .nav-link:hover, .nav-link.active { color: var(--ink); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .icon-btn { display: grid; place-items: center; width: 2rem; height: 2rem; border: 0; background: none; color: var(--ink-soft); cursor: pointer; border-radius: 50%; transition: background .25s, color .25s; }
  .icon-btn:hover { background: var(--bg-soft); color: var(--ink); }
  :global([data-theme='dark']) .sun { display: none; }
  :global([data-theme='light']) .moon { display: none; }

  /* パレットメニュー */
  .palette-wrap { position: relative; }
  .palette-popover {
    position: absolute; top: calc(100% + .6rem); right: -1rem;
    background: var(--bg); border: 1px solid var(--line);
    border-radius: 8px; padding: .8rem .9rem;
    box-shadow: 0 10px 25px -5px rgb(0 0 0 / .15);
    min-width: 9rem; z-index: 100;
  }
  .palette-title { font-size: .62rem; margin-bottom: .6rem; }
  .palette-list { display: flex; flex-direction: column; gap: .3rem; }
  .palette-item {
    display: flex; align-items: center; gap: .6rem;
    background: none; border: 0; padding: .35rem .5rem;
    border-radius: 4px; cursor: pointer; color: var(--ink);
    font-size: .82rem; font-family: var(--sans); width: 100%;
    transition: background .2s;
  }
  .palette-item:hover { background: var(--bg-soft); }
  .swatch { width: .75rem; height: .75rem; border-radius: 50%; }
  .swatch-forest { background: hsl(152 26% 34%); }
  .swatch-ocean { background: hsl(205 60% 36%); }
  .swatch-sunset { background: hsl(18 68% 42%); }
  .swatch-granite { background: hsl(220 16% 36%); }
  .swatch-plum { background: hsl(338 38% 40%); }

  @media (max-width: 640px) {
    nav { gap: .8rem; }
    .nav-link { font-size: .7rem; letter-spacing: .06em; }
    .brand span { display: none; }
  }
</style>
