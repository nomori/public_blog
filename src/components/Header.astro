---
import { SITE_TITLE } from '../consts';
import { url } from '../lib/content';
const path = Astro.url.pathname;
const nav = [
  { href: url('/posts/'), label: 'Journal' },
  { href: url('/notes/'), label: 'Notes' },
  { href: url('/photos/'), label: 'Photos' },
  { href: url('/tags/'), label: 'Tags' },
];
---
<header class="site-header">
  <div class="container inner">
    <a href={url('/')} class="brand" id="brand-link">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 20 L9 8 L13 14 L16 10 L22 20 Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      <span>{SITE_TITLE}</span>
    </a>
    <nav aria-label="メイン">
      {nav.map((n) => (
        <a href={n.href} class:list={['nav-link', { active: path.startsWith(n.href) }]} id={`nav-${n.label.toLowerCase()}`}>{n.label}</a>
      ))}
      <a href={url('/search/')} class="icon-btn" aria-label="検索" id="nav-search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <button class="icon-btn" id="theme-toggle" aria-label="テーマ切替">
        <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px) saturate(1.4);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }
  .inner { display: flex; align-items: center; justify-content: space-between; height: 4rem; }
  .brand { display: flex; align-items: center; gap: .6rem; font-family: var(--serif); font-weight: 700; font-size: 1.05rem; letter-spacing: .06em; }
  .brand svg { color: var(--accent); transition: transform .5s var(--ease); }
  .brand:hover svg { transform: translateY(-2px); }
  nav { display: flex; align-items: center; gap: 1.6rem; }
  .nav-link { font-size: .8rem; letter-spacing: .12em; color: var(--ink-soft); position: relative; transition: color .25s; }
  .nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px; background: var(--accent); transform: scaleX(0); transition: transform .35s var(--ease); }
  .nav-link:hover, .nav-link.active { color: var(--ink); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .icon-btn { display: grid; place-items: center; width: 2rem; height: 2rem; border: 0; background: none; color: var(--ink-soft); cursor: pointer; border-radius: 50%; transition: background .25s, color .25s; }
  .icon-btn:hover { background: var(--bg-soft); color: var(--ink); }
  :global([data-theme='dark']) .sun { display: none; }
  :global([data-theme='light']) .moon { display: none; }
  @media (max-width: 640px) {
    nav { gap: .9rem; }
    .nav-link { font-size: .7rem; letter-spacing: .06em; }
    .brand span { display: none; }
  }
</style>
