# --ai で本文をAI下書きする場合（Google AI Studio で取得）
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Googleフォトから写真をダウンロードする場合 (Google Cloud ConsoleでOAuth Webクライアントを作成)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# （任意）公開サイトURL・ベースパスの上書き（Cloudflare Pages やさくらで環境変数で渡す場合）
# ASTRO_SITE=https://example.com
# ASTRO_BASE=/

# ============================================================
# GPX プライバシーゾーン（自宅・職場等の秘匿領域）
# 設定すると、GPX解析時にこの地点から半径xxx m以内のトラックポイントを自動除外します
# ============================================================
# PRIVACY_ZONE_LAT=35.681236
# PRIVACY_ZONE_LON=139.767125
# PRIVACY_ZONE_RADIUS_M=500

# 複数地点を設定したい場合 (セミコロン区切り: 緯度,経度,半径m)
# PRIVACY_ZONES=35.681236,139.767125,500;35.658034,139.701636,300

